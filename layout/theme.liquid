<script>
(function () {
  const SELECTORS = {
    inventory: '.hdt-product-info__item.hdt-product__inventory, .hdt-product__inventory',
    quantity: '.hdt-product-info__item.hdt-quantity-wrapp, .hdt-quantity-wrapp, .hdt-product-info__item.hdt-product__quantity'
  };

  function arrangeOnce() {
    const inventory = document.querySelector(SELECTORS.inventory);
    const quantity = document.querySelector(SELECTORS.quantity);

    if (!inventory || !quantity) return;

    // jeśli już w docelowym wrapperze -> nic nie rób
    if (inventory.closest('.hdt-flex-quantity-inventory') || quantity.closest('.hdt-flex-quantity-inventory')) return;

    // jeśli mają tego samego rodzica -> dodaj klasę parenta (ustawimy mu flex w CSS)
    if (inventory.parentElement === quantity.parentElement) {
      inventory.parentElement.classList.add('hdt-flex-quantity-inventory-parent');
      return;
    }

    // inaczej: stwórz wrapper i przenieś elementy do niego (przed quantity)
    const wrapper = document.createElement('div');
    wrapper.className = 'hdt-flex-quantity-inventory';
    // wstaw wrapper tam, gdzie znajduje się quantity (po to, by zachować kontekst layoutu)
    const qParent = quantity.parentElement;
    qParent.insertBefore(wrapper, quantity);
    wrapper.appendChild(quantity);
    wrapper.appendChild(inventory);
  }

  // wywołaj natychmiast po załadowaniu DOM i po dynamicznych zmianach
  document.addEventListener('DOMContentLoaded', arrangeOnce);
  // próbne uruchomienie w krótkim czasie (na wypadek gdyby coś ładowało asynchronicznie)
  setTimeout(arrangeOnce, 500);
  setTimeout(arrangeOnce, 1500);

  // dotyczy tylko karty produktu — na innych stronach nie obserwuj DOM
  if (!document.body.classList.contains('hdt-page-type-product')) return;

  // obserwator DOM (np. zmiana wariantu, Ajax itp.) — zbija serie mutacji do max 1 sprawdzenia na klatkę
  let scheduled = false;
  const observer = new MutationObserver(function () {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(function () {
      scheduled = false;
      arrangeOnce();
    });
  });
  const target = document.getElementById('MainContent') || document.body;
  observer.observe(target, { childList: true, subtree: true });
})();
</script>
<script>
document.addEventListener('click', function (e) {
  // Sprawdzamy, czy kliknięty link to nasz "#otworz-formularz"
  if (e.target.closest('a[href$="#otworz-formularz"]')) {
    e.preventDefault(); 
    
    // TUTAJ WKLEJASZ KOD Z KLAVIYO:
    window._klOnsite = window._klOnsite || [];
    window._klOnsite.push(['openForm', 'T7CrLW']);
  }
});
</script>
<script>
document.addEventListener('click', function(e) {
  // Sprawdzamy czy kliknięto w nasz konkretny link
  if (e.target.getAttribute('href') === '/#sklep-odstapienie') {
    e.preventDefault();
    console.log("Próba otwarcia formularza...");

    // 1. Sprawdź czy obiekt już istnieje
    if (window.EUWithdrawalForm && typeof window.EUWithdrawalForm.open === 'function') {
      window.EUWithdrawalForm.open();
    } 
    // 2. Jeśli nie, wyślij zdarzenie, którego wtyczka może nasłuchiwać
    else {
      window.dispatchEvent(new CustomEvent('eu-withdrawal:open', { 
        detail: { trigger: e.target } 
      }));
      console.log("Wysłano event eu-withdrawal:open");
    }
  }
});
</script>
