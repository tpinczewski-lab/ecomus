es":"<p>{{ closest.product.metafields.custom.kr_tki_opis | metafield_tag }}</p>","readm":false,"length":30,"readm_txt":"Czytaj więcej","readl_txt":"Zwiń"},"blocks":{}},"custom_liquid_AqmiHh":{"type":"_custom-liquid","name":"Custom liquid","settings":{"liquid":"<div class=\"routines-bis-placement-wrapper\">\n  {%- assign current_variant = product.selected_or_first_available_variant -%}\n  \n  {%- unless current_variant.available -%}\n    {%- comment -%} \n      Wstawiamy czysty kod triggera Klaviyo. \n      Nie dodajemy do niego żadnych dodatkowych klas ani styli, \n      żeby skrypt Klaviyo mógł go poprawnie \"złapać\".\n    {%- endcomment -%}\n    <a class=\"klaviyo-bis-trigger\" href=\"#\">Powiadom o dostępności</a>\n  {%- endunless -%}\n</div>\n\n<style>\n  /* Ten kontener dba tylko o to, żeby przycisk był pod ceną i miał odstęp */\n  .routines-bis-placement-wrapper {\n    display: block;\n    margin: 20px 0;\n    width: 100%;\n    clear: both;\n  }\n\n  /* Ukrywamy ewentualne automatyczne napisy Klaviyo, \n     które mogłyby wyskoczyć nad Twoim przyciskiem */\n  .routines-bis-placement-wrapper + span {\n    display: none !important;\n  }\n</style>"},"blocks":{}},"custom_liquid_FCw3tb":{"type":"_custom-liquid","name":"Selektor i ATC","settings":{"liquid":"{%- assign current_variant = product.selected_or_first_available_variant -%}\n\n{%- if current_variant.available -%}\n<div class=\"custom-atc-wrapper\">\n  {%- form 'product', product, id: 'custom-atc-form' -%}\n    <input type=\"hidden\" name=\"id\" value=\"{{ current_variant.id }}\">\n\n    <div class=\"atc-flex-row\">\n      <div class=\"qty-container-slim\">\n        <button type=\"button\" class=\"qty-btn-inv\" onclick=\"this.parentNode.querySelector('input').stepDown()\">−</button>\n        <input type=\"number\" name=\"quantity\" value=\"1\" min=\"1\" class=\"qty-input-inv no-arrows\">\n        <button type=\"button\" class=\"qty-btn-inv\" onclick=\"this.parentNode.querySelector('input').stepUp()\">+</button>\n      </div>\n\n      <button type=\"submit\" name=\"add\" class=\"main-atc-button\" id=\"AddToCart-Button\">\n        <span class=\"btn-text\">DODAJ DO KOSZYKA</span>\n      </button>\n\n      <button type=\"button\" class=\"wishlist-btn-small\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path></svg>\n      </button>\n    </div>\n  {%- endform -%}\n</div>\n\n<script>\n  document.querySelector('#custom-atc-form').addEventListener('submit', function(e) {\n    e.preventDefault();\n    let formData = new FormData(this);\n    let btn = document.querySelector('#AddToCart-Button');\n    let btnText = btn.querySelector('.btn-text');\n    \n    btnText.innerText = 'DODAJE...';\n\n    fetch(window.Shopify.routes.root + 'cart/add.js', {\n      method: 'POST',\n      body: formData\n    })\n    .then(response => response.json())\n    .then(item => {\n      btnText.innerText = 'DODANO! 👍';\n      \n      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: item } }));\n      \n      const cartDrawer = document.querySelector('cart-drawer') || document.querySelector('#CartDrawer');\n      if (cartDrawer && typeof cartDrawer.open === 'function') cartDrawer.open();\n      \n      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));\n\n      setTimeout(() => { btnText.innerText = 'DODAJ DO KOSZYKA'; }, 2000);\n    })\n    .catch((error) => {\n      console.error('Error:', error);\n      btnText.innerText = 'BŁĄD';\n    });\n  });\n</script>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap');\n\n  .custom-atc-wrapper { \n    margin: 15px 0; \n    width: 100%; \n    padding-bottom: 8px; \n  }\n  \n  .atc-flex-row { \n    display: flex; \n    gap: 10px; \n    align-items: center; \n    height: 48px; \n  }\n\n  .qty-container-slim {\n    display: flex;\n    align-items: center;\n    background: #ffffff;\n    border: 1px solid #4E54F0;\n    border-radius: 50px;\n    height: 100%;\n    min-width: 85px;\n  }\n  \n  .qty-btn-inv {\n    background: transparent;\n    border: none;\n    color: #4E54F0;\n    cursor: pointer;\n    font-size: 16px;\n    width: 28px;\n    display: flex;\n    justify-content: center;\n  }\n  \n  .qty-input-inv.no-arrows {\n    background: transparent;\n    border: none;\n    color: #4E54F0;\n    text-align: center;\n    width: 25px;\n    font-family: 'Poppins', sans-serif;\n    font-weight: 700;\n    font-size: 14px;\n    -moz-appearance: textfield;\n  }\n  .qty-input-inv::-webkit-outer-spin-button, .qty-input-inv::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n\n  .main-atc-button {\n    position: relative;\n    flex: 1;\n    height: 100%;\n    background: #4E54F0;\n    color: white;\n    border: none;\n    border-radius: 50px;\n    font-family: 'Poppins', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: 0.5px;\n    cursor: pointer;\n    box-shadow: 0 5px 0 #3238b5;\n    transition: all 0.1s ease;\n    top: 0;\n  }\n\n  .main-atc-button:hover { \n    filter: brightness(1.05);\n  }\n\n  .main-atc-button:active {\n    top: 3px;\n    box-shadow: 0 2px 0 #3238b5;\n  }\n\n  .wishlist-btn-small {\n    width: 42px;\n    height: 42px;\n    background: transparent;\n    border: 1px solid #e2e2e2;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    color: #888;\n    transition: all 0.2s;\n    flex-shrink: 0;\n  }\n  \n  .wishlist-btn-small:hover { border-color: #4E54F0; color: #4E54F0; }\n  .wishlist-btn-small svg { width: 18px; height: 18px; }\n\n  @media (max-width: 480px) {\n    .atc-flex-row { height: 46px; gap: 8px; }\n    .main-atc-button { font-size: 13px; box-shadow: 0 4px 0 #3238b5; }\n    .main-atc-button:active { top: 2px; box-shadow: 0 2px 0 #3238b5; }\n    .qty-container-slim { min-width: 80px; }\n    .wishlist-btn-small { width: 40px; height: 40px; }\n  }\n</style>\n{%- endif -%}"},"blocks":{}},"quantity_selector_6zJAfX":{"type":"_quantity-selector","disabled":true,"settings":{},"blocks":{}},"product_buy_button_9gRLMx":{"type":"_product-buy-button","disabled":true,"settings":{"show_dynamic_checkout":true,"show_gift_card_recipient":false,"show_wishlist":true,"show_compare":false,"show_price_variant":false},"blocks":{}},"custom_liquid_Epq9LV":{"type":"_custom-liquid","name":"Custom liquid","settings":{"liquid":"{% render 'rou-upsell-modal', product: product, section_id: section.id %}"},"blocks":{}},"custom_liquid_tTQJyk":{"type":"_custom-liquid","name":"Custom liquid","settings":{"liquid":"{% render 'rou-accordion-pills', product: product, section_id: section.id %}"},"blocks":{}},"aov_ai_bundle_offer_inline_FyaNqP":{"type":"shopify://apps/aov-ai-bundle/blocks/offer-inline/0335d423-143c-4ad7-b224-99a1db74a9ee","disabled":true,"settings":{}}},"block_order":["product_title_JjxmKw","custom_liquid_W67geK","custom_liquid_ieBymq","custom_liquid_QeMK66","product_price_VhBaXe","custom_liquid_Q8xzB3","sniffie_omnibus_pricing_omnibus_price_bhx7Th","product_description_DP7AQm","custom_liquid_AqmiHh","custom_liquid_FCw3tb","quantity_selector_6zJAfX","product_buy_button_9gRLMx","custom_liquid_Epq9LV","custom_liquid_tTQJyk","aov_ai_bundle_offer_inline_FyaNqP"]},"main-product":{"type":"_product-medias","static":true,"settings":{"display_by_block":true,"color_scheme":"scheme-78f8dbc4-0585-419d-be4a-d71463f5c911","desktop_media_layout":"2_columns","media_size":"small","mobile_media_layout":"fraction","enable_thumb_efect":true,"show_first_media":false,"use_select_varaint_change_media":true,"enable_media_autoplay":true,"enable_video_looping":true,"image_ratio":"square","image_size":true,"image_zoom":"lightbox","image_zoom_type":"external","zoom_level":2,"max_zoom_light