em\">\n      <summary class=\"routines-acc-pill-header\">\n        <span class=\"routines-acc-pill-title\">Składniki (INCI)</span>\n        <span class=\"routines-acc-pill-arrow\">\n          <svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg>\n        </span>\n      </summary>\n      <div class=\"routines-acc-pill-content\">\n        <div class=\"routines-acc-pill-content-inner\">\n          {{ product.metafields.custom.skladniki_inci | metafield_tag }}\n        </div>\n      </div>\n    </details>\n  {%- endif -%}\n\n</div>\n\n<style>\n  /* Import czcionek dla spójności */\n  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Barlow:wght@700&display=swap');\n\n  .routines-accordion-pills {\n    margin: 15px 0;\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: 12px; /* Odstęp między \"pigułkami\" */\n  }\n\n  /* STYL PIGUŁKI (Jak ramka Upsell) */\n  .routines-acc-pill-item {\n    border: 1px solid #e2e2e2;\n    border-radius: 60px; /* Pełne zaokrąglenie */\n    background: #fff;\n    overflow: hidden;\n    transition: all 0.3s ease;\n  }\n\n  /* Zmiana zaokrąglenia przy otwarciu, żeby treść lepiej wyglądała */\n  .routines-acc-pill-item[open] {\n    border-radius: 25px; \n    border-color: #4E54F0; /* Delikatne zaznaczenie otwartej karty kolorem Routines */\n  }\n\n  .routines-acc-pill-header {\n    display: flex;\n    align-items: center;\n    padding: 12px 25px; /* Większy padding boczny dla pigułki */\n    cursor: pointer;\n    list-style: none;\n    position: relative;\n    user-select: none;\n  }\n\n  .routines-acc-pill-header::-webkit-details-marker { display: none; }\n\n  /* NAGŁÓWEK: Barlow 16px, Bold */\n  .routines-acc-pill-title {\n    font-family: 'Barlow', sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n    color: #000;\n    text-transform: none;\n  }\n\n  /* STRZAŁKA: Granat Routines #4E54F0 */\n  .routines-acc-pill-arrow {\n    margin-left: auto;\n    color: #4E54F0;\n    display: flex;\n    align-items: center;\n    transition: transform 0.3s ease;\n  }\n\n  /* Obrót strzałki przy otwarciu */\n  .routines-acc-pill-item[open] .routines-acc-pill-arrow {\n    transform: rotate(180deg);\n  }\n\n  /* TREŚĆ */\n  .routines-acc-pill-content {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease-out;\n  }\n\n  .routines-acc-pill-item[open] .routines-acc-pill-content {\n    max-height: 1000px;\n  }\n\n  .routines-acc-pill-content-inner {\n    padding: 0 25px 20px 25px;\n    font-family: 'Poppins', sans-serif;\n    font-size: 14px;\n    line-height: 1.6;\n    color: #444;\n  }\n\n  .routines-acc-pill-content-inner p {\n    margin: 0 0 10px 0 !important;\n  }\n\n  /* Efekt hover na pigułce */\n  .routines-acc-pill-item:hover {\n    border-color: #4E54F0;\n  }\n\n  @media (max-width: 767px) {\n    .routines-acc-pill-header {\n      padding: 10px 20px;\n    }\n    .routines-acc-pill-title {\n      font-size: 14px;\n    }\n    .routines-acc-pill-item {\n        border-radius: 40px; /* Nieco mniejszy promień na mobile */\n    }\n  }\n</style>"},"blocks":{}},"aov_ai_bundle_offer_inline_FyaNqP":{"type":"shopify://apps/aov-ai-bundle/blocks/offer-inline/0335d423-143c-4ad7-b224-99a1db74a9ee","disabled":true,"settings":{}},"tolstoy_ads_image_video_tolstoy_builder_bPFdaf":{"type":"shopify://apps/tolstoy-ads-image-video/blocks/tolstoy-builder/06fa8282-42ff-403e-b67c-1936776aed11","settings":{"custom_code":"<tolstoy-widget data-tolstoy-widget-id=\"01KVSKJMN0P0MQB9SDGDW76D78\" data-product-id=\"{{ product.id }}\" data-tags=\"{%- for tag in product.tags -%}{{ tag | escape }},{%- endfor -%}\"></tolstoy-widget>\n<script src=\"https://ai-widgets.gotolstoy.com/3ebbb759-c474-4fff-9283-5c1b8aad8c08/01KVSKJMN0P0MQB9SDGDW76D78/latest/dist/widget.iife.js\" defer></script>"}}},"block_order":["product_title_Jj