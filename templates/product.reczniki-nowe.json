{"sections":{"breadcrumb":{"type":"brc-nav-product","settings":{"back_next_pr":true,"color_scheme":"scheme-c9476b69-abc7-454f-a946-2d5a9f5f3a37","padding_top":30,"padding_bottom":30,"padding_rate":75}},"main-product":{"type":"main-product","blocks":{"group_product_rjwCiM":{"type":"_group-product","settings":{},"blocks":{"product_title_JjxmKw":{"type":"_product-title","settings":{"hdt_pr_title_size":"h3"},"blocks":{}},"custom_liquid_AwWwQ4":{"type":"_custom-liquid","settings":{"liquid":"{% render 'rou-key-ingredients', product: product, section_id: section.id %}"},"blocks":{}},"trustoo_io_reviews_star_rating_widget_nPHKwF":{"type":"shopify://apps/trustwill-trustoo/blocks/star-rating-widget/c8f15077-6475-4e86-ad06-b66038d5ba2c","settings":{"star_size":20,"font_size":16,"text_color":"#585858","block_aligment":"left","rating_decimal_places":"1","margin_top":10,"margin_bottom":0}},"product_description_WKEATr":{"type":"_product-description","settings":{"des":"2","short_des":"","readm":false,"length":30,"readm_txt":"Czytaj więcej","readl_txt":"Zwiń"},"blocks":{}},"product_price_VhBaXe":{"type":"_product-price","disabled":true,"settings":{},"blocks":{}},"custom_liquid_LjcjXd":{"type":"_custom-liquid","name":"Custom liquid","settings":{"liquid":"{%- comment -%} \n  KOMPLETNY KOD SEKCJI PRODUKTOWEJ - WARIANTY + ILOŚĆ SZTUK \n{%- endcomment -%}\n\n{%- liquid\n  assign current_variant = product.selected_or_first_available_variant\n  if request.query_parameters.variant\n    assign current_variant = product.variants | where: 'id', request.query_parameters.variant | first | default: current_variant\n  endif\n\n  assign current_price = current_variant.price\n  assign compare_price = current_variant.compare_at_price | default: 0\n  assign suggested_price = current_variant.metafields.custom.cena_sugerowana.value | default: product.metafields.custom.cena_sugerowana.value | default: 0\n  \n  # Liczba pakietów (pobieramy z nazwy wariantu lub osobnego metafielda, tu zakładamy logiczny podział)\n  assign pack_count = current_variant.title | split: ' ' | first | plus: 0\n  \n  assign disc_suggested = 0\n  if suggested_price > current_price\n    assign diff = suggested_price | minus: current_price\n    assign disc_suggested = diff | times: 100.0 | divided_by: suggested_price | round\n  endif\n\n  assign disc_compare = 0\n  if compare_price > current_price\n    assign diff = compare_price | minus: current_price\n    assign disc_compare = diff | times: 100.0 | divided_by: compare_price | round\n  endif\n  \n  assign is_on_sale = false\n  if suggested_price > current_price or compare_price > current_price\n    assign is_on_sale = true\n  endif\n\n  assign newsletter_price = current_price | times: 0.85\n-%}\n\n<div id=\"section-{{ section.id }}\" class=\"p-section-final\">\n  <style>\n    .p-variant-selector { display: flex; gap: 10px; margin-bottom: 20px; }\n    .p-variant-btn { padding: 8px 16px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer; background: #fff; font-family: 'Barlow', sans-serif; transition: 0.3s; }\n    .p-variant-btn.active { border-color: #000; background: #f0f0f0; font-weight: 700; }\n    .p-flex-container { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; }\n    .p-main-val { font-size: 32px; font-weight: 700; color: {% if is_on_sale %}#D32F2F{% else %}#000{% endif %}; }\n    .p-sale-badge { background-color: #D32F2F; color: #fff; font-size: 11px; padding: 3px 8px; border-radius: 3px; text-transform: uppercase; margin-left: 10px; }\n    \n    /* Nowy styl dla ilości sztuk */\n    .p-unit-info { font-size: 16px; color: #000; font-weight: 500; margin-top: 5px; }\n    .p-unit-info strong { font-weight: 700; }\n    \n    .p-ref-price { font-size: 13px; color: #868686; margin-top: 6px; }\n    .p-disc-val { color: #D32F2F; font-weight: 600; }\n    .p-newsletter-box { flex: 1; border-left: 1px solid #E0E0E0; padding-left: 20px; }\n    .p-news-trigger { text-decoration: underline; cursor: pointer; font-size: 11px; color: #555; }\n  </style>\n\n  {% comment %} SELEKTOR WARIANTÓW {% endcomment %}\n  <div class=\"p-variant-selector\">\n    {% for variant in product.variants %}\n      <a href=\"{{ variant.url }}\" class=\"p-variant-btn {% if variant.id == current_variant.id %}active{% endif %}\">\n        {{ variant.title }}\n      </a>\n    {% endfor %}\n  </div>\n\n  <div class=\"p-flex-container\">\n    <div class=\"p-info-main\">\n      <div class=\"p-price-row\">\n        <span class=\"p-main-val\">{{ current_price | money }}</span>\n        {% if is_on_sale %}<span class=\"p-sale-badge\">OKAZJA</span>{% endif %}\n      </div>\n      \n      {% comment %} Zmieniona sekcja: Ilość w opakowaniu {% endcomment %}\n      <div class=\"p-unit-info\">\n        Ilość w opakowaniu: <strong>{{ pack_count }} x 80 szt.</strong>\n      </div>\n\n      <div class=\"p-ref-price\">\n        {% if suggested_price > 0 %}\n          <div>Cena sugerowana: <strong>{{ suggested_price | money }}</strong> \n            {% if disc_suggested > 0 %}<span class=\"p-disc-val\">(-{{ disc_suggested }}%)</span>{% endif %}\n          </div>\n        {% endif %}\n        {% if compare_price > 0 %}\n          <div>Najniższa cena z 30 dni: <strong>{{ compare_price | money }}</strong> \n            {% if disc_compare > 0 %}<span class=\"p-disc-val\">(-{{ disc_compare }}%)</span>{% endif %}\n          </div>\n        {% endif %}\n      </div>\n    </div>\n\n    {% unless is_on_sale %}\n      <div class=\"p-newsletter-box\">\n        <div style=\"font-weight: 600; font-size: 16px;\">{{ newsletter_price | money }} z kodem</div>\n        <div class=\"p-news-trigger\" onclick=\"openKlaviyoForm()\">Zapisz się do newslettera i odbierz kod</div>\n      </div>\n    {% endunless %}\n  </div>\n</div>\n\n<script>\n  function openKlaviyoForm() {\n    if (window._klOnsite) { window._klOnsite.push(['openForm', 'WCWzaD']); }\n  }\n</script>"},"blocks":{}},"custom_liquid_cX3tVd":{"type":"_custom-liquid","name