{"sections":{"1768811868d08fd587":{"type":"apps","blocks":{"powerful_form_builder_app_block_b6pa8B":{"type":"shopify:\/\/apps\/powerful-form-builder\/blocks\/app-block\/e4bcb1eb-35b2-42e6-bc37-bfe0e1542c9d","settings":{"shortcode":""}}},"block_order":["powerful_form_builder_app_block_b6pa8B"],"settings":{"include_margins":true}},"custom_liquid_CHbRif":{"type":"custom-liquid","custom_css":[],"name":"t:sections.custom-liquid.presets.name","settings":{"section_fullwidth":true,"custom_liquid":"<div id=\"game-zone\" class=\"game-wrapper-box\">\n  <div class=\"game-overlay-trigger\">KLIKNIJ, ABY ZAGRAĆ<\/div>\n  <iframe src=\"https:\/\/game.routines.pl\/space\/?v=5\" id=\"game-frame\" scrolling=\"no\"><\/iframe>\n<\/div>\n\n<style>\n  .game-wrapper-box {\n    position: relative;\n    width: 100%;\n    height: 700px;\n    margin: 20px 0;\n    border: 3px solid #000;\n    background: #000;\n    overflow: hidden;\n  }\n  #game-frame {\n    width: 100%;\n    height: 100%;\n    border: none;\n  }\n  .game-overlay-trigger {\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 100%;\n    background: rgba(0,0,0,0.4);\n    color: white;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: 'Poppins', sans-serif;\n    font-weight: 800;\n    cursor: pointer;\n    z-index: 10;\n    transition: 0.3s;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    text-align: center;\n    padding: 20px;\n  }\n  .game-overlay-trigger.hidden {\n    opacity: 0;\n    pointer-events: none;\n  }\n  \/* Blokada scrolla - aktywna tylko gdy JS doda klasę (teraz tylko na Desktop) *\/\n  html.lock-my-scroll, \n  html.lock-my-scroll body {\n    overflow: hidden !important;\n    height: 100% !important;\n    position: fixed !important;\n    width: 100% !important;\n    top: 0 !important;\n  }\n<\/style>\n\n<script>\n(function() {\n  const zone = document.getElementById('game-zone');\n  const frame = document.getElementById('game-frame');\n  const trigger = zone.querySelector('.game-overlay-trigger');\n  const html = document.documentElement;\n\n  \/\/ 1. AUTO-SCROLL PO WEJŚCIU NA STRONĘ (MOBILE)\n  window.addEventListener('load', function() {\n    if (window.innerWidth < 768) {\n      setTimeout(() => {\n        zone.scrollIntoView({ behavior: 'smooth', block: 'start' });\n      }, 800);\n    }\n  });\n\n  \/\/ AKTYWACJA GRY\n  function activateGame() {\n    zone.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    \n    const isDesktop = window.innerWidth >= 768;\n\n    setTimeout(() => {\n      \/\/ Blokujemy ekran TYLKO na desktopie\n      if (isDesktop) {\n        html.classList.add('lock-my-scroll');\n      }\n      trigger.classList.add('hidden');\n      frame.focus();\n    }, 500); \n  }\n\n  \/\/ DEZAKTYWACJA GRY\n  function deactivateGame() {\n    html.classList.remove('lock-my-scroll');\n    trigger.classList.remove('hidden');\n\n    setTimeout(() => {\n      zone.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }, 10);\n  }\n\n  trigger.addEventListener('click', activateGame);\n\n  \/\/ Kliknięcie poza obszar gry przywraca nakładkę\n  window.addEventListener('click', function(e) {\n    if (!zone.contains(e.target) && trigger.classList.contains('hidden')) {\n      deactivateGame();\n    }\n  });\n\n  window.addEventListener('keydown', function(e) {\n    if (e.key === \"Escape\" && trigger.classList.contains('hidden')) {\n      deactivateGame();\n    }\n  });\n\n  \/\/ HARD LOCK STRZAŁEK (DESKTOP)\n  const preventArrows = function(e) {\n    if([\"Space\",\"ArrowUp\",\"ArrowDown\",\"ArrowLeft\",\"ArrowRight\"].indexOf(e.code) > -1) {\n      e.preventDefault();\n    }\n  };\n\n  zone.addEventListener('mouseenter', () => {\n    window.addEventListener('keydown', preventArrows, {passive: false});\n  });\n\n  zone.addEventListener('mouseleave', () => {\n    window.removeEventListener('keydown', preventArrows, {passive: false});\n  });\n})();\n<\/script>","color_scheme":"","padding_top":0,"padding_bottom":0,"padding_rate":75}}},"order":["1768811868d08fd587","custom_liquid_CHbRif"]}