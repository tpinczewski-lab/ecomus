: suggested_price | round\n  endif\n\n  assign disc_compare = 0\n  if compare_price > current_price\n    assign diff = compare_price | minus: current_price\n    assign disc_compare = diff | times: 100.0 | divided_by: compare_price | round\n  endif\n  \n  # Pobieranie pojemności i obliczanie ceny za 100ml\n  assign volume = product.metafields.custom.pojemnosc.value | default: 50 | remove: 'ml' | strip | plus: 0\n  assign unit_price_100ml = current_price | times: 1.0 | divided_by: volume | times: 100\n  \n  # Promocja aktywna, jeśli cena jest niższa od którejkolwiek ceny odniesienia\n  assign is_on_sale = false\n  if suggested_price > current_price or compare_price > current_price\n    assign is_on_sale = true\n  endif\n\n  assign newsletter_price = current_price | times: 0.85\n-%}\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Poppins:wght@400;500&display=swap');\n  .p-section-final { font-family: 'Barlow', sans-serif; color: #1A1A1A; max-width: 550px; margin: 10px 0; }\n  .p-flex-container { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; }\n  .p-price-row { display: flex; align-items: center; gap: 10px; line-height: 1; margin-bottom: 8px; }\n  .p-main-val { font-size: 32px; font-weight: 700; color: #000; }\n  .p-main-val.is-sale { color: #D32F2F; }\n  \n  .p-sale-badge { background-color: #D32F2F; color: #fff; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 3px; text-transform: uppercase; }\n  \n  .p-unit-info { font-size: 16px; color: #000; font-weight: 500; margin-top: 5px; }\n  .p-unit-info strong { font-weight: 700; }\n  \n  .p-ref-price { font-size: 13px; color: #868686; margin-top: 6px; line-height: 1.5; }\n  .p-ref-val { font-weight: 600; color: #000; }\n  .p-disc-val { color: #D32F2F; font-weight: 600; }\n  \n  .p-newsletter-box { flex: 1; border-left: 1px solid #E0E0E0; padding-left: 20px; display: flex; flex-direction: column; justify-content: center; }\n  .p-news-price { display: block; font-size: 16px; font-weight: 600; }\n  .p-news-trigger { background: none; border: none; padding: 0; text-align: left; font-size: 11px; text-decoration: underline; cursor: pointer; color: #555; }\n</style>\n\n<div class=\"p-section-final\">\n  <div class=\"p-flex-container\">\n    <div class=\"p-info-main\">\n      <div class=\"p-price-row\">\n        <span class=\"p-main-val {% if is_on_sale %}is-sale{% endif %}\">{{ current_price | money }}</span>\n        {% if is_on_sale %}<span class=\"p-sale-badge\">OKAZJA</span>{% endif %}\n      </div>\n      \n      <div class=\"p-unit-info\">\n        Pojemność: <strong>{{ volume }} ml</strong> ({{ unit_price_100ml | money }} / 100 ml)\n      </div>\n\n      <div class=\"p-ref-price\">\n        {% if suggested_price > 0 %}\n          <div>Cena sugerowana: <span class=\"p-ref-val\">{{ suggested_price | money }}</span> \n            {% if disc_suggested > 0 %}<span class=\"p-disc-val\">(-{{ disc_suggested }}%)</span>{% endif %}\n          </div>\n        {% endif %}\n        {% if compare_price > 0 %}\n          <div>Najniższa cena z 30 dni: <span class=\"p-ref-val\">{{ compare_price | money }}</span> \n            {% if disc_compare > 0 %}<span class=\"p-disc-val\">(-{{ disc_compare }}%)</span>{% endif %}\n          </div>\n        {% endif %}\n      </div>\n    </div>\n\n    {% unless is_on_sale %}\n      <div class=\"p-newsletter-box\">\n        <span class=\"p-news-price\">{{ newsletter_price | money }} z kodem</span>\n        <button type=\"button\" class=\"p-news-trigger\" onclick=\"openKlaviyoForm()\">Zapisz się do newslettera i odbierz kod</button>\n      </div>\n    {% endunless %}\n  </div>\n</div>\n\n<script>\n  function openKlaviyoForm() {\n    if (window._klOnsite) { window._klOnsite.push(['openForm', 'WCWzaD']); }\n  }\n</script>"},"blocks":{}},"sniffie_omnibus_pricing_omnibus_price_bhx7Th":{"type":"shopify://apps/complimus-eu-omnibus-price/blocks/omnibus-price/befd495a-705f-454e-9a70-d1d491f84538","settings":{"hide_if_not_on_sale":true,"hide_if_equal_to_compare_at_price":false,"label":"Najniższa cena z ostatnich 30 dni","show_percentage":true,"date_format":"%d.%m.%Y","hide_date":false,"field":"price","update_variant_details_dynamically":false,"font_size":12,"text_color":"#868686","price_adjustment":0,"round_up_to":"0","add_after_rounding":0,"exclude_tag":"","exclude_market":""}},"product_inventory_BM3qpr":{"type":"_product-inventory","settings":{"inventory_threshold":5,"show_inventory_quantity":false,"show_progress_bar":false,"progress_bar_max":15},"blocks":{}},"aov_ai_bundle_offer_volume_NqF7wD":{"type":"shopify://apps/aov-ai-bundle/blocks/offer-volume/0335d423-143c-4ad7-b224-99a1db74a9ee","settings":{}},"custom_liquid_CyiwqA":{"type":"_custom-liquid","name":"Custom liquid","settings":{"liquid":"<div class=\"custom-atc-wrapper\">\n  {%- form 'product', product, id: 'custom-atc-form' -%}\n    <input type=\"hidden\" name=\"id\" value=\"{{ product.selected_or_first_available_variant.id }}\">\n\n    <div class=\"atc-flex-row\">\n      <div class=\"qty-container-slim\">\n        <button type=\"button\" class=\"qty-btn-inv\" onclick=\"this.parentNode.querySelector('input').stepDown()\">−</button>\n        <input type=\"number\" name=\"quantity\" value=\"1\" min=\"1\" class=\"qty-input-inv no-arrows\">\n        <button type=\"button\" class=\"qty-btn-inv\" onclick=\"this.parentNode.querySelector('input').stepUp()\">+</button>\n      </div>\n\n      <button type=\"submit\" name=\"add\" class=\"main-atc-button\" id=\"AddToCart-Button\">\n        <span class=\"btn-text\">DODAJ DO KOSZYKA</span>\n      </button>\n\n      <button type=\"button\" class=\"wishlist-btn-small\" data-product-handle=\"{{ product.handle }}\" id=\"wishlist-trigger\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path>\n        </svg>\n      </button>\n    </div>\n  {%- endform -%}\n</div>\n\n<script>\n  // DODAWANIE DO KOSZYKA\n  document.querySelector('#custom-atc-form').addEventListener('submit', function(e) {\n    e.preventDefault();\n    let formData = new FormData(this);\n    fetch(window.Shopify.routes.root + 'cart/add.js', { method: 'POST', body: formData })\n    .then(response => response.json())\n    .then(item => {\n      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: item } }));\n      const drawer = document.querySelector('cart-drawer') || document.querySelector('#CartDrawer');\n      if (drawer && typeof drawer.open === 'function') drawer.open();\n      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));\n    }).catch(err => console.error(err));\n  });\n\n  // LOGIKA LISTY ŻYCZEŃ\n  (function() {\n    const btn = document.getElementById('wishlist-trigger');\n    const handle = btn.getAttribute('data-product-handle');\n    const STORAGE_KEY = 'shopify-wishlist';\n\n    let wishlist = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];\n    if (wishlist.includes(handle)) btn.classList.add('is-active');\n\n    btn.addEventListener('click', function() {\n      wishlist = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];\n      const index = wishlist.indexOf(handle);\n\n      if (index > -1) {\n        wishlist.splice(index, 1);\n        this.classList.remove('is-active');\n      } else {\n        wishlist.push(handle);\n        this.classList.add('is-active');\n      }\n\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(wishlist));\n      document.dispatchEvent(new CustomEvent('wishlist:updated'));\n    });\n  })();\n</script>\n\n<style>\n  .custom-atc-wrapper { margin: 15px 0; width: 100%; }\n  .atc-flex-row { display: flex; gap: 10px; align-items: center; height: 48px; }\n\n  /* SELEKTOR */\n  .qty-container-slim { display: flex; align-items: center; background: #fff; border: 1px solid #000; height: 100%; min-width: 90px; }\n  .qty-btn-inv { background: transparent; border: none; color: #000; cursor: pointer; font-size: 18px; width: 30px; height: 100%; display: flex; align-items: center; justify-content: center; }\n  .qty-input-inv { background: transparent; border: none; color: #000; text-align: center; width: 30px; font-weight: 700; font-family: inherit; font-size: 14px; }\n  .no-arrows::-webkit-outer-spin-button, .no-arrows::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n\n  /* PRZYCISK ATC */\n  .main-atc-button { flex: 1; height: 100%; background: #000; color: #fff; border: none; font-weight: 700; letter-spacing: 1px; cursor: pointer; font-size: 14px; }\n\n  /* PRZYCISK WISHLIST */\n  .wishlist-btn-small { \n    width: 48px; height: 48px; background: transparent; border: 1px solid #000; \n    display: flex; align-items: center; justify-content: center; cursor: pointer; color: #000; \n    flex-shrink: 0;\n  }\n  .wishlist-btn-small svg { width: 22px; height: 22px; transition: all 0.2s ease; }\n\n  .wishlist-btn-small.is-active { border-color: #ff0000; color: #ff0000; }\n  .wishlist-btn-small.is-active svg { fill: #ff0000; stroke: #ff0000; }\n\n  /* POPRAWKI DLA MOBILE */\n  @media (max-width: 480px) { \n    .atc-flex-row { height: 44px; gap: 6px; } \n    \n    .qty-container-slim { min-width: 75px; } /* Zmniejszona szerokość całkowita */\n    .qty-btn-inv { width: 25px; font-size: 16px; } /* Węższe przyciski +/- */\n    .qty-input-inv { width: 25px; font-size: 13px; } /* Węższe pole wpisywania */\n    \n    .main-atc-button { font-size: 12px; letter-spacing: 0.5px; }\n    \n    .wishlist-btn-small { width: 44px; height: 44px; } /* Dopasowanie do wysokości rzędu */\n  }\n</style>"},"blocks":{}},"product_buy_button_NjT8CT":{"type":"_product-buy-button","name":"t:sections.main-product.blocks.buy_buttons.name","disabled":true,"settings":{"show_dynamic_checkout":false,"show_gif