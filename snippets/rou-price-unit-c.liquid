{% comment %}
  Wspólny blok kart produktu (używany w 3 miejscach w szablonach product.*).
  Edytuj TUTAJ — zmiana obejmie wszystkie karty produktów, które go renderują.
  Wywołanie: {% render 'rou-price-unit-c', product: product, section_id: section.id %}
{% endcomment %}
{% comment %} --- LOGIKA I OBLICZENIA --- {% endcomment %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign on_sale = false %}
{% if current_variant.compare_at_price > current_variant.price %}
  {% assign on_sale = true %}
{% endif %}

{% comment %} Pobieranie wartości z metapola custom.pojemnosc {% endcomment %}
{% assign volume = product.metafields.custom.pojemnosc.value | default: product.metafields.custom.pojemnosc | default: 50 %}

{% comment %} Obliczenie ceny jednostkowej na 100g {% endcomment %}
{% assign unit_price_100g = current_variant.price | times: 1.0 | divided_by: volume | times: 100 %}
{% assign newsletter_price = current_variant.price | times: 0.85 %}

{% comment %} Pobieranie danych Omnibus {% endcomment %}
{% assign omnibus_price = product.metafields.app--320503809--omnibus.priceHistory %}

<style>
  .p-section-final {
    font-family: 'Barlow', sans-serif;
    color: #1A1A1A;
    max-width: 550px;
    margin: 10px 0;
  }

  .p-flex-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }

  .p-info-main {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    gap: 2px; 
  }

  .p-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    line-height: 1;
  }

  .p-main-val {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .p-main-val.sale-active { color: #D32F2F; }

  .p-compare-val {
    font-size: 18px;
    color: #6b6b6b;
    text-decoration: line-through;
    font-weight: 400;
  }

  .p-sub-info {
    font-size: 13px;
    color: #666;
    font-weight: 400;
    margin-top: 2px;
  }

  .p-omnibus-info {
    font-size: 11px;
    color: #6b6b6b;
    margin-top: 4px;
    line-height: 1.3;
  }

  .p-capacity-label {
    font-size: 15px;
    margin-top: 8px; 
    color: #1A1A1A;
  }

  .p-newsletter-box {
    flex: 1;
    border-left: 1px solid #E0E0E0;
    padding-left: 20px;
    min-height: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .p-news-price {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: #000;
    line-height: 1.2;
  }

  .p-news-trigger {
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    font-family: 'Barlow', sans-serif;
    font-size: 13px;
    color: #1A1A1A;
    text-decoration: underline;
    font-weight: 500;
    cursor: pointer;
    line-height: 1.3;
    margin-top: 4px;
  }

  @media (max-width: 480px) {
    .p-flex-container { flex-direction: column; gap: 15px; }
    .p-newsletter-box {
      border-left: none;
      padding: 12px 15px;
      background-color: #F8F8F8; 
      border-radius: 4px;
      width: 100%;
      box-sizing: border-box;
    }
    .p-main-val { font-size: 28px; }
  }
</style>

<div class="p-section-final">
  <div class="p-flex-container">
    
    <div class="p-info-main">
      <div class="p-price-row">
        <span class="p-main-val {% if on_sale %}sale-active{% endif %}">
          {{ current_variant.price | money }}
        </span>
        {% if on_sale %}
          <span class="p-compare-val">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>
      
      <div class="p-sub-info">
        {% comment %} Zmienione na / 100 g {% endcomment %}
        {{ unit_price_100g | money }} / 100 g
      </div>

      {% if on_sale and omnibus_price != blank %}
        <div class="p-omnibus-info">
          Najniższa cena produktu w okresie 30 dni przed wprowadzeniem obniżki: {{ omnibus_price | money }}
        </div>
      {% endif %}

      <div class="p-capacity-label">
        {% comment %} Zmienione na g {% endcomment %}
        Waga: <strong>{{ volume }} g</strong>
      </div>
    </div>

    {% unless on_sale %}
      <div class="p-newsletter-box">
        <span class="p-news-price">{{ newsletter_price | money }} z kodem</span>
        <button type="button" class="p-news-trigger" onclick="openKlaviyoForm()">
          Zapisz się do newslettera i odbierz kod
        </button>
      </div>
    {% endunless %}

  </div>
</div>

<script>
  function openKlaviyoForm() {
    if (window._klOnsite) {
      window._klOnsite.push(['openForm', 'WCWzaD']);
    } else {
      console.warn('Klaviyo form trigger: _klOnsite is not defined yet.');
    }
  }
</script>
