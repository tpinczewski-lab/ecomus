{%- comment -%}
  Renders a product card (Style 11) with Omnibus Compliance
  Metafields: app--320503809--omnibus
{%- endcomment -%}
<style>
  /* Stylizacja badge'y dla widoku kolekcji na mobile */
  @media screen and (max-width: 767px) {
    .hdt-card-product .hdt-badge {
      /* Zwiększ te wartości, jeśli są za małe, lub zmniejsz, jeśli za duże */
      font-size: 11px !important;    /* Nieco większa czcionka dla czytelności */
      padding: 3px 6px !important;   /* Nieco większy padding dla "oddechu" */
      min-height: 20px !important;   /* Większa wysokość dla lepszego klikania */
      line-height: 1.2 !important;
    }
    
    /* Odstępy między samymi badge'ami na mobile */
    .hdt-card-product .hdt-badge__wrapp {
      gap: 5px !important;
    }
  }
</style>
{%- liquid
  unless product_url
    assign product_url = card_product.url
  endunless
  assign featured_media = card_product.featured_media | default: settings.placeholder_img
  assign color_count = 0
  assign size_count = 0
  
  if card_product.has_only_default_variant == false and settings.color_mode != 'hide' or settings.size_mode != 'hide'
    assign available_variants = card_product.variants | where: "available"
    for option in card_product.options_with_values
      assign name_downcase = option.name | downcase
      if settings.color_mode != 'hide' and color_list contains name_downcase and color_count == 0
        assign color_option_index = 'option' | append: forloop.index
        assign color_variants = option.values
        assign color_variants_avai = available_variants | map: color_option_index | uniq
        if settings.color_type == 'all'
          assign color_count = color_variants.size
        else
          if card_product.options_with_values.size == 1
            assign color_variants = color_variants_avai
          endif
          assign color_count = color_variants_avai.size
        endif
      elsif settings.size_mode != 'hide' and size_list contains name_downcase and size_count == 0
        assign size_option_index = 'option' | append: forloop.index
        assign size_variants_avai = available_variants | map: size_option_index | uniq
        assign size_variants = option.values
        if settings.size_type == 'all'
          assign size_count = size_variants.size
        else
          if card_product.options_with_values.size == 1
            assign size_variants = size_variants_avai
          endif
          assign size_count = size_variants_avai.size
        endif
      endif
    endfor
  endif
-%}

<hdt-card-product class="hdt-card-product {{ class }}{% if settings.show_ultra_btn == false %} hdt-no-ultra_btn{% endif %}{% if card_product.available == false %} hdt-pr-sold_out{% endif %}">
  <div class="hdt-card-product__wrapper" calc-nav>
    
    {%- comment -%} MEDIA SECTION {%- endcomment -%}
    <div class="hdt-card-product__media hdt-relative hdt-oh">
      <a data-pr-url href="{{ product_url }}" data-instant calc-nav class="hdt-card-product__media-wrapp hdt-ratio" {% if image_ratio == 'adapt_image' %} style="--aspect-ratioapt: {{ featured_media.aspect_ratio | default: '127.7777778%' }}"{% endif %}>
        {%- if featured_media -%}
          {{ featured_media | image_url: width: featured_media.width | image_tag: loading: 'lazy', sizes: sizes, widths: '165, 360, 533, 668, 720, 940, 1066, 1200', class: 'hdt-card-product__media--main' }}
          {%- if card_product.media[1] != null and settings.show_secondary_image -%}
            {%- assign next_media = card_product.media[featured_media.position] | default: card_product.media[1] -%}
            {{ next_media | image_url: width: next_media.width | image_tag: loading: 'lazy', sizes: sizes, widths: '165, 360, 533, 668, 720, 940, 1066, 1200', class: 'hdt-card-product__media--hover' }}
          {%- endif -%}
        {%- endif -%}
      </a>
      {%- render 'badges', product: card_product, use_variant: false -%}
      <div class="hdt-product-btns hdt-pr-btns-group2 hdt-absolute">
        {{ btn_wishlist_code | replace_first: '19041994', card_product.id | replace_first: 'handle_nt_94', card_product.handle }}
        {%- if settings.compare_mode != "0" -%}
          {%- render 'btn-compare', product_id: card_product.id, product_handle: card_product.handle, class: 'hdt-pr_btn hdt-card-product__btn-compare', placement: 'top' -%}
        {%- endif -%}
        {%- if settings.show_quick_view -%}
          {%- render 'btn-quick-view', class: 'hdt-pr_btn', product: card_product, section_id: section_id, placement: 'top' -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} INFO SECTION {%- endcomment -%}
    <div class="hdt-card-product__info hdt-card-align-{{ settings.pr_card_alignment }} hdt-relative">
      {%- if settings.show_rating %}{% render 'hdt-pr-card-rating', product: card_product %}{% endif -%}
      
      {%- if card_product.vendor.size > 0 and show_vendor -%}
        {%- render 'vendor' with card_product.vendor, class: 'hdt-inline-block hdt-text-base hdt-font-normal' -%}
      {%- endif -%}
      
      <a data-pr-url href="{{ product_url }}" class="hdt-card-product__title hdt-text-{{ settings.pr_title_size }} hdt-font-{{ settings.pr_title_weight }} {% if settings.hdt_show_long_title == false %} hdt-line-clamp {% endif %}" data-instant>
        {{ card_product.title | escape }}
      </a>

      {%- if card_product.metafields.custom.w_a_ciwo_ci_produktu -%}
        <div class="collection-promotion">
          <p>{{ card_product.metafields.custom.w_a_ciwo_ci_produktu }}</p>
        </div>
      {%- endif -%}

<style>
  @media screen and (max-width: 767px) {
    .hdt-promo-info-mobile {
      font-size: 9px !important; /* Zmniejszenie czcionki na mobile */
    }
    .hdt-promo-info-mobile .hdt-no-wrap {
      white-space: nowrap; /* Wymuszenie by cena i % były w jednej linii */
    }
  }
</style>

<style>
  /* Ustawienia dla desktopu */
  .hdt-promo-info-mobile {
    font-size: 10px !important; 
  }
  
  /* Ustawienia dla mobile */
  @media screen and (max-width: 767px) {
    .hdt-promo-info-mobile {
      font-size: 9px !important;
    }
    .hdt-promo-info-mobile .hdt-no-wrap {
      white-space: nowrap;
    }
  }
</style>

<style>
  /* Ustawienia dla desktopu - nieco większa czcionka */
  .hdt-promo-info-mobile {
    font-size: 12px !important; 
  }
  
  /* Ustawienia dla mobile - zostawiamy mniejszą czcionkę (9px) */
  @media screen and (max-width: 767px) {
    .hdt-promo-info-mobile {
      font-size: 9px !important;
    }
    .hdt-promo-info-mobile .hdt-no-wrap {
      white-space: nowrap;
    }
  }
</style>

{%- comment -%} PRICE, OMNIBUS & REGULAR PRICE SECTION {%- endcomment -%}
{%- liquid
    assign current_variant = card_product.selected_or_first_available_variant
    assign current_price = current_variant.price
    
    # Pobieranie danych
    assign compare_price = card_product.compare_at_price | default: 0
    assign suggested_price = card_product.metafields.custom.cena_sugerowana.value | default: 0
    
    # Funkcja do liczenia procentu
    # Używamy zmiennych pomocniczych wewnątrz Liquid
    assign disc_suggested = 0
    if suggested_price > current_price
       assign diff = suggested_price | minus: current_price
       assign disc_suggested = diff | times: 100.0 | divided_by: suggested_price | round
    endif
    
    assign disc_compare = 0
    if compare_price > current_price
       assign diff = compare_price | minus: current_price
       assign disc_compare = diff | times: 100.0 | divided_by: compare_price | round
    endif

    # Cena sprzedaży jest na czerwono jeśli jest niższa od KTÓREJKOLWIEK ceny odniesienia
    assign is_on_sale = false
    if compare_price > current_price or suggested_price > current_price
       assign is_on_sale = true
    endif

    assign volume = card_product.metafields.custom.pojemnosc.value | default: 50 | remove: 'ml' | strip | plus: 0
    assign unit_price_100ml = current_price | times: 1.0 | divided_by: volume | times: 100
-%}

<div class="hdt-price-wrapper" style="margin-top: auto; padding-bottom: 0;">
  
  <div class="hdt-custom-price-row" style="display: flex; align-items: baseline; justify-content: center; gap: 6px; flex-wrap: wrap;">
    <div style="font-weight: 700; font-size: 20px; color: {% if is_on_sale %}#D32F2F{% else %}#000{% endif %}; line-height: 1;">
      {{ current_price | money }}
    </div>
    <div style="font-size: 13px; color: #555; line-height: 1;">
      {{ unit_price_100ml | money }} / 100 ml
    </div>
  </div>

  <div class="hdt-promo-info hdt-promo-info-mobile" style="text-align: center; color: #868686; margin-top: 10px; margin-bottom: 2px; line-height: 1.3;">
    
    {%- if suggested_price > 0 -%}
      <div class="hdt-no-wrap">
        Cena sugerowana: <strong style="color: #000;">{{ suggested_price | money }}</strong>
        {%- if disc_suggested > 0 -%} 
          <span style="color: #D32F2F;">(-{{ disc_suggested }}%)</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    {%- if compare_price > 0 -%}
      <div class="hdt-no-wrap" style="margin-top: 2px;">
        Najniższa cena z 30 dni: <strong style="color: #000;">{{ compare_price | money }}</strong>
        {%- if disc_compare > 0 -%} 
          <span style="color: #D32F2F;">(-{{ disc_compare }}%)</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    
  </div>
</div>

      {%- comment -%} SWATCHES & BUTTONS {%- endcomment -%}
      {%- liquid
        if size_count > 0
          render 'size-list', size_variants: size_variants, size_variants_avai: size_variants_avai, size_count: size_count
        endif
        if color_count > 0
          render 'color-list', section_id: section_id, product: card_product, product_url: product_url, color_variants: color_variants, color_variants_avai: color_variants_avai, color_count: color_count, color_option_index: color_option_index, placement: 'top'
        endif
      -%}

      {%- if settings.show_ultra_btn -%}
        <div class="hdt-product-btns hdt-pr-btns-group1">
          {%- render 'btn-ultra', class: 'hdt-pr_btn', product: card_product, product_url: product_url, section_id: section_id, disable_sr_only: true, show_qty: settings.show_qty -%}
        </div>
      {%- endif -%}
      
    </div> {%- comment -%} Close hdt-card-product__info {%- endcomment -%}
  </div> {%- comment -%} Close hdt-card-product__wrapper {%- endcomment -%}
</hdt-card-product>