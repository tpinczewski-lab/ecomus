{% comment %}
  Wspólny blok kart produktu (używany w 10 miejscach w szablonach product.*).
  Edytuj TUTAJ — zmiana obejmie wszystkie karty produktów, które go renderują.
  Wywołanie: {% render 'rou-availability-b', product: product, section_id: section.id %}
{% endcomment %}
{%- comment -%} LOGIKA DYNAMICZNEGO CZASU WYSYŁKI {%- endcomment -%}

{%- assign current_hour = "now" | date: "%H" | plus: 0 -%}



{%- if current_hour < 13 -%}

  {%- assign shipping_text = "Zamów do 13:00, a wyślemy dzisiaj" -%}

{%- else -%}

  {%- assign shipping_text = "Wyślemy jutro" -%}

{%- endif -%}



<div class="product-availability-wrapper">

  {%- if product.available -%}

    <div class="availability-item">

      <div class="status-icon">

        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#28a745" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>

      </div>

      <div class="status-text">

        <span class="main-label"><strong>Dostępny</strong> online</span>

        <span class="sub-label">{{ shipping_text }}</span>

      </div>

    </div>

  {%- endif -%}



  <div class="availability-item">

    <div class="status-icon">

      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#28a745" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>

    </div>

    <div class="status-text">

      <span class="main-label"><strong>Dostępny</strong> w Rossmann</span>

      <span class="sub-label">

        <button type="button" id="open-rossmann-map" class="status-link-btn">Znajdź najbliższy sklep</button>

      </span>

    </div>

  </div>

</div>



<div id="map-modal-overlay" class="map-modal-overlay">

  <div class="map-modal-content">

    <button type="button" id="close-map-modal" class="map-modal-close">&times;</button>

    <div class="map-modal-header">Znajdź nas w Rossmann</div>

    <div class="map-container-inner">

      <stockist-store-locator data-stockist-widget-tag="map_93eyxev3">

        Ładowanie mapy...

      </stockist-store-locator>

    </div>

  </div>

</div>



<script async src="https://stockist.co/embed/v1/widget.min.js"></script>



<style>

  .product-availability-wrapper {

    display: flex;

    justify-content: flex-start;

    gap: 40px;

    margin: 20px 0;

    width: 100%;

    font-family: 'Poppins', sans-serif;

  }



  .availability-item {

    display: flex;

    align-items: flex-start;

    gap: 10px;

  }



  .status-icon { padding-top: 3px; flex-shrink: 0; }

  .status-text { display: flex; flex-direction: column; line-height: 1.3; }

  

  .main-label { 

    font-size: 13px; 

    color: #000; 

    white-space: nowrap; 

  }

  

  /* SZARE TEKSTY POD SPODEM */

  .sub-label, .status-link-btn { 

    font-size: 11px; 

    color: #777; /* Szary kolor dla obu sekcji */

    margin-top: 2px; 

  }



  .status-link-btn {

    background: none;

    border: none;

    padding: 0;

    text-decoration: underline;

    cursor: pointer;

    font-family: inherit;

    text-align: left;

    transition: color 0.2s;

  }



  .status-link-btn:hover { color: #000; }



  /* MODAL STYLE */

  .map-modal-overlay {

    position: fixed;

    top: 0; left: 0; width: 100%; height: 100%;

    background: rgba(0, 0, 0, 0.7);

    backdrop-filter: blur(4px);

    z-index: 2147483647;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 20px;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition: all 0.3s ease;

  }

  .map-modal-overlay.is-active { opacity: 1; visibility: visible; pointer-events: auto; }

  .map-modal-content {

    background: #fff;

    width: 100%;

    max-width: 900px;

    height: 80vh;

    position: relative;

    padding: 30px;

    transform: translateY(20px);

    transition: transform 0.4s ease;

  }

  .map-modal-overlay.is-active .map-modal-content { transform: translateY(0); }

  .map-modal-header { font-weight: 700; font-size: 16px; text-transform: uppercase; margin-bottom: 20px; }

  .map-modal-close { position: absolute; top: 15px; right: 20px; background: none; border: none; font-size: 32px; cursor: pointer; }

  .map-container-inner { flex: 1; height: calc(100% - 60px); border: 1px solid #f0f0f0; }



  /* MOBILE */

  @media (max-width: 768px) {

    .product-availability-wrapper {

      justify-content: space-between;

      gap: 10px;

      margin: 15px 0;

    }

    .availability-item { flex: 1; gap: 6px; }

    .main-label { font-size: 10.5px; }

    .sub-label, .status-link-btn { font-size: 9.5px; }

    .status-icon svg { width: 15px; height: 15px; }

    .map-modal-content { height: 85vh; padding: 20px 10px; }

  }



  @media (max-width: 380px) {

    .main-label { font-size: 9px; }

    .sub-label, .status-link-btn { font-size: 8.5px; }

  }

</style>



<script>

  document.addEventListener('DOMContentLoaded', function() {

    const modal = document.getElementById('map-modal-overlay');

    const openBtn = document.getElementById('open-rossmann-map');

    const closeBtn = document.getElementById('close-map-modal');



    if(openBtn) {

      openBtn.addEventListener('click', function(e) {

        e.preventDefault();

        modal.classList.add('is-active');

        document.body.style.overflow = 'hidden';

        setTimeout(() => { window.dispatchEvent(new Event('resize')); }, 150);

      });

    }



    const closeModal = () => {

      modal.classList.remove('is-active');

      document.body.style.overflow = '';

    };



    if(closeBtn) closeBtn.addEventListener('click', closeModal);

    if(modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  });

</script>
